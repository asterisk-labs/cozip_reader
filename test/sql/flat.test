# name: test/sql/flat.test
# group: [sql]

require cozip

require parquet


# flat_simple

query T
SELECT cozip_profile('test/data/flat_simple.zip');
----
flat

query I
SELECT count(*) FROM read_flat('test/data/flat_simple.zip');
----
4

query TT
SELECT "name", "category" FROM read_flat('test/data/flat_simple.zip', location := false)
ORDER BY "name";
----
denver.txt	text
lima.txt	text
paris.txt	text
tokyo.txt	text

query II
SELECT count(*), sum("size") > 0
FROM read_flat('test/data/flat_simple.zip', location := false);
----
4	true

query I
SELECT bool_and("offset" > prev) FROM (
  SELECT "offset", LAG("offset") OVER (ORDER BY "offset") AS prev
  FROM read_flat('test/data/flat_simple.zip', location := false)
) t
WHERE prev IS NOT NULL;
----
true

query I
SELECT count(*) FROM read_flat('test/data/flat_simple.zip')
WHERE "cozip:location" LIKE '/vsisubfile/%,test/data/flat_simple.zip';
----
4

query I
SELECT count(*) FROM read_flat('test/data/flat_simple.zip')
WHERE "cozip:location" = '/vsisubfile/' || "offset"::VARCHAR || '_' || "size"::VARCHAR || ',test/data/flat_simple.zip';
----
4

query I
SELECT count(*) FROM read_flat('test/data/flat_simple.zip')
WHERE "cozip:location" LIKE '%/vsicurl/%';
----
0

query III nosort same_rows
SELECT "name", "offset", "size" FROM read_flat('test/data/flat_simple.zip', location := false)
ORDER BY "name";
----

query III nosort same_rows
SELECT "name", "offset", "size" FROM read_flat('test/data/flat_simple.zip', location := false)
ORDER BY "name";
----


# flat_geo
# geometry comes back as GEOMETRY — read_parquet honours GeoParquet metadata

query I
SELECT count(*) FROM read_flat('test/data/flat_geo.zip');
----
4

query I
SELECT count(*) FROM read_flat('test/data/flat_geo.zip', location := false)
WHERE "geometry" IS NOT NULL;
----
4

query TT
SELECT "name", "category" FROM read_flat('test/data/flat_geo.zip', location := false)
ORDER BY "name";
----
denver.txt	text
lima.txt	text
paris.txt	text
tokyo.txt	text

statement ok
CREATE TEMP TABLE want(name VARCHAR);

statement ok
INSERT INTO want VALUES ('lima.txt'), ('tokyo.txt');

query T
SELECT c."name" FROM read_flat('test/data/flat_geo.zip', location := false) c
JOIN want w ON c."name" = w."name"
ORDER BY c."name";
----
lima.txt
tokyo.txt


# errors

statement error
SELECT * FROM read_flat(NULL);
----
cannot take NULL

# The deprecated alias still resolves to the same manifest.

query I
SELECT count(*) FROM read_cozip('test/data/flat_simple.zip');
----
4

# A TACO archive is a valid cozip, so the reader has to name the profile
# rather than fail with a parse error.

statement error
SELECT * FROM read_flat('test/data/taco_flat.zip');
----
Got profile=taco

statement error
SELECT * FROM read_flat('test/sql/flat.test');
----
cozip archive too small

statement error
SELECT * FROM read_flat('test/data/does_not_exist.zip');
----
Cannot open file

statement error
SELECT * FROM read_flat('test/data/flat_bad_hash.zip');
----
integrity hash mismatch

# read_cozip is an alias of read_flat and emits the same column.

query I
SELECT count(*) FROM read_cozip('test/data/flat_simple.zip')
WHERE "cozip:location" LIKE '/vsisubfile/%';
----
4

# cozip spec 13.4: the column is computed, never read from __metadata__.

statement error
SELECT "cozip:location" FROM read_parquet(
  'cozip-subfile://' || cozip_offset_size('test/data/flat_simple.zip') || '!test/data/flat_simple.zip');
----

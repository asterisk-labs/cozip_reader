# name: test/sql/taco.test
# group: [sql]

require cozip

require parquet


# taco_flat.zip: two fixed leaves, metadata at the collection and sample levels.
# The default shape is one row per sample with one column per structure leaf.

query T
SELECT cozip_profile('test/data/taco_flat.zip');
----
taco

query I
SELECT count(*) FROM read_taco('test/data/taco_flat.zip');
----
4

query TT
SELECT "image.bin" IS NOT NULL, "label.bin" IS NOT NULL
FROM read_taco('test/data/taco_flat.zip') WHERE sample_id = 0;
----
true	true

query T
SELECT list(split ORDER BY sample_id) FROM read_taco('test/data/taco_flat.zip');
----
[train, val, train, val]

# Every data column is a byte range into the archive it came from.

query I
SELECT count(*) FROM read_taco('test/data/taco_flat.zip')
WHERE "image.bin" LIKE '/vsisubfile/%,test/data/taco_flat.zip';
----
4

query I
SELECT count(*) FROM read_taco('test/data/taco_flat.zip', gdal_vsi := false)
WHERE "image.bin" IS NOT NULL;
----
0


# taco_nested.zip: before/ and after/ folders, so four contract levels.

query T
SELECT taco_levels('test/data/taco_nested.zip');
----
[collection, sample, sample/after, sample/before]

query T
SELECT taco_structure('test/data/taco_nested.zip');
----
[before/B02.bin, before/B03.bin, after/B02.bin, change.bin]

query I
SELECT count(*) FROM read_taco('test/data/taco_nested.zip');
----
3

# Folder rows carry no bytes, so the flat shape has one row per file only.

query I
SELECT count(*) FROM read_taco('test/data/taco_nested.zip', pivoted := false);
----
12

query TTT
SELECT path, kind, resolution
FROM read_taco('test/data/taco_nested.zip', pivoted := false)
WHERE sample_id = 0 ORDER BY path;
----
after/B02.bin	imagery	20
before/B02.bin	imagery	10
before/B03.bin	imagery	10
change.bin	label	NULL

# A file at the sample level inherits nothing from the deeper levels.

query I
SELECT count(*) FROM read_taco('test/data/taco_nested.zip', pivoted := false)
WHERE path = 'change.bin' AND resolution IS NULL;
----
3

# files restricts which leaves become columns.

query I
SELECT count(*) FROM (SELECT * FROM read_taco('test/data/taco_nested.zip', files := ['change.bin']));
----
3

# idx is an integer for one sample and a half-open range for several.

query I
SELECT list(sample_id) FROM read_taco('test/data/taco_nested.zip', idx := 1);
----
[1]

query I
SELECT list(sample_id) FROM read_taco('test/data/taco_nested.zip', idx := [1, 3]);
----
[1, 2]

# level returns one contract level with its internal columns intact.

query I
SELECT count(*) FROM read_taco('test/data/taco_nested.zip', level := 'sample/before');
----
6

query T
SELECT "internal:relative_path" FROM read_taco('test/data/taco_nested.zip', level := 'sample/before')
ORDER BY "internal:current_id" LIMIT 1;
----
0/before/B02.bin


# taco_variable.zip: a variable leaf becomes one LIST column named by its prefix.

query TT
SELECT n_images, len("img") FROM read_taco('test/data/taco_variable.zip') ORDER BY sample_id;
----
0	0
1	1
2	2

query T
SELECT bool_and("img" IS NULL)
FROM read_taco('test/data/taco_variable.zip', gdal_vsi := false);
----
true

# The list follows the cardinal index, not lexicographic order.

query I
SELECT "img"[1] = (SELECT "cozip:gdal_vsi" FROM read_taco('test/data/taco_variable.zip', pivoted := false)
                   WHERE sample_id = 2 AND path = 'img0.bin')
FROM read_taco('test/data/taco_variable.zip') WHERE sample_id = 2;
----
true


# taco_null.zip: taco:structure is null, so each sample is one file.

query T
SELECT taco_structure('test/data/taco_null.zip');
----
[]

query I
SELECT count(*) FROM read_taco('test/data/taco_null.zip');
----
6

query I
SELECT count(*) FROM read_taco('test/data/taco_null.zip')
WHERE "cozip:gdal_vsi" LIKE '/vsisubfile/%';
----
6


# FOLDER mode: the same dataset unpacked to a directory. No offsets, so the
# data column is a plain filesystem path.

query I
SELECT count(*) FROM read_taco('test/data/taco_folder');
----
4

query T
SELECT "image.bin" FROM read_taco('test/data/taco_folder') WHERE sample_id = 0;
----
test/data/taco_folder/DATA/0/image.bin

query I
SELECT count(*) FROM read_taco('test/data/taco_folder', pivoted := false);
----
8


# TACOCAT: row ids restart in every partition, so identity is (source, id).

query I
SELECT count(*) FROM read_taco('test/data/taco_cat/.tacocat');
----
6

query I
SELECT count(DISTINCT source_file) FROM read_taco('test/data/taco_cat/.tacocat');
----
2

# Byte ranges resolve against the partition beside the catalog, not inside it.

query I
SELECT count(*) FROM read_taco('test/data/taco_cat/.tacocat')
WHERE "image.bin" LIKE '/vsisubfile/%,test/data/taco_cat/part_%.zip';
----
6


# contract overview needs no JSON extension

query II
SELECT kind, count(*) FROM taco_contract('test/data/taco_nested.zip') GROUP BY kind ORDER BY kind;
----
level	4
structure	4

query T
SELECT taco_collection('test/data/taco_nested.zip') LIKE '%"taco:structure"%';
----
true


# errors

statement error
SELECT * FROM read_taco('test/data/flat_simple.zip');
----
Got profile=flat

statement error
SELECT * FROM read_taco('test/data/does_not_exist.zip');
----
Cannot open file

statement error
SELECT * FROM read_taco('test/data/taco_nested.zip', level := 'nope');
----
has no level 'nope'

statement error
SELECT * FROM read_taco('test/data/taco_nested.zip', idx := 'x');
----
idx must contain non-negative integers

statement error
SELECT * FROM read_taco('test/data/taco_nested.zip', idx := '1junk');
----
idx must contain non-negative integers

statement error
SELECT * FROM read_taco('test/data/taco_nested.zip', idx := [-1, 2]);
----
idx must contain non-negative integers

statement error
SELECT * FROM read_taco('test/data/taco_nested.zip', files := ['nope.bin']);
----
no structure leaf matches

# A dataset whose COLLECTION.json is unreadable fails with a message that
# names the file, rather than crashing inside the generator.

statement error
SELECT * FROM read_taco('test/data/taco_badjson');
----
COLLECTION.json is not valid JSON

# Both shapes need the contract: the flat one reads it to decide which level
# owns a field that two levels declare. Only a raw level read gets through.

statement error
SELECT * FROM read_taco('test/data/taco_badjson', pivoted := false);
----
COLLECTION.json is not valid JSON

query I
SELECT count(*) FROM read_taco('test/data/taco_badjson', level := 'sample');
----
8

# A field declared at two levels is not a collision: the row carries the value
# of the level it belongs to, and the shallower one is hidden.

query TTI
SELECT sample_id, path, resolution
FROM read_taco('test/data/taco_shadow.zip', pivoted := false)
ORDER BY sample_id, path;
----
0	before/B02.bin	3
0	change.bin	2
1	before/B02.bin	3
1	change.bin	2
